# Frontend environment variables.
#
# Copy to .env.local for local development. Vite only exposes variables prefixed
# with VITE_, and everything here ends up in the client bundle -- so nothing
# secret belongs in this file.

# Leave blank to use the Vite dev proxy (see vite.config.ts), which forwards
# /api to http://localhost:8000. Set it to an absolute origin only when the
# frontend and backend are served from different hosts.
VITE_API_URL=
