# Database Configuration
DATABASE_URL=postgresql://vendoruser:vendorpass@localhost:5432/vendordb

# AI Provider Configuration
# "mock" = deterministic, keyless. Set to "openai" + a real key to use the LLM.
LLM_PROVIDER=mock
OPENAI_API_KEY=
# Optional. Any OpenAI-compatible gateway (e.g. http://127.0.0.1:20128/v1).
# Blank means the SDK default, api.openai.com.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Security
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY_HEADER=X-API-Key

# n8n Configuration
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=n8n-api-key

# Mock External Services
ERP_API_URL=http://localhost:8001
COMPLIANCE_API_URL=http://localhost:8002

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Document storage (native run: relative to the repo root you launch from).
# The Docker default /app/documents/uploads is not writable on Windows.
DOCUMENT_STORAGE_PATH=./documents/uploads

# n8n: N8N_API_KEY is the shared secret the n8n workflows send back on
# POST /api/webhooks/n8n. It must match VOR_CALLBACK_SECRET in docker-compose.yml.
# There is no UI password: n8n 2.x creates the owner account on first load.